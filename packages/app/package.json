{
  "name": "@openharness/app",
  "version": "0.0.1",
  "private": true,
  "description": "The Electron desktop app: multi-pane workspace over Schematic / Layout / Parts / Connections / Diagnostics views (spec \u00a77). GUI is mandatory per the reference app.",
  "author": {
    "name": "OpenHarness contributors",
    "email": "dunhamconnor14@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/connordunham/openharness",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "prebuild": "tsc -b ../core ../parts ../render ../io",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "dev": "concurrently -k -n renderer,electron -c blue,green \"npm run dev:renderer\" \"npm run build:electron -- --watch --preserveWatchOutput\" ",
    "electron:dev": "cross-env OPENHARNESS_DEV=1 electron dist-electron/main.js",
    "package": "electron-builder",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "package:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@openharness/core": "*",
    "@openharness/io": "*",
    "@openharness/parts": "*",
    "@openharness/render": "*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.0",
    "immer": "^10.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
