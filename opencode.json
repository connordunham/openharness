{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/HANDOFF.md", "docs/DOMAIN-DECISIONS.md"],

  "agent": {
    "harness-lead": { "model": "openrouter/anthropic/claude-sonnet-4.5" },
    "implementer": { "model": "openrouter/anthropic/claude-sonnet-4.5" },
    "reviewer": { "model": "openrouter/openai/gpt-5" },
    "verifier": { "model": "openrouter/anthropic/claude-sonnet-4.5" },
    "packet-scout": { "model": "openrouter/qwen/qwen3-coder" },
    "domain-auditor": { "model": "openrouter/anthropic/claude-sonnet-4.5" }
  },

  "provider": {
    "openrouter": {
      "models": {
        "anthropic/claude-sonnet-4.5": {
          "limit": { "output": 8000 }
        },
        "openai/gpt-5": {
          "limit": { "output": 8000 }
        },
        "qwen/qwen3-coder": {
          "limit": { "output": 8000 }
        }
      }
    }
  }
}
