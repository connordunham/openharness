{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/anthropic/claude-haiku-4.5",
  "small_model": "openrouter/anthropic/claude-haiku-4.5",
  "instructions": ["AGENTS.md", "docs/HANDOFF.md", "docs/DOMAIN-DECISIONS.md"],

  "agent": {
    "harness-lead":   { "model": "openrouter/anthropic/claude-haiku-4.5" },
    "architect":      { "model": "openrouter/moonshotai/kimi-k3" },
    "packet-scout":   { "model": "openrouter/anthropic/claude-haiku-4.5" },
    "implementer":    { "model": "openrouter/google/gemini-3.7-flash" },
    "reviewer":       { "model": "openrouter/qwen/qwen3.8-27b" },
    "verifier":       { "model": "openrouter/anthropic/claude-haiku-4.5" },
    "domain-auditor": { "model": "openrouter/moonshotai/kimi-k3" },
    "maintainer":     { "model": "openrouter/anthropic/claude-haiku-4.5" }
  },

  "provider": {
    "openrouter": {
      "models": {
        "anthropic/claude-haiku-4.5":  { "limit": { "context": 200000, "output": 16000 } },
        "moonshotai/kimi-k3":          { "limit": { "context": 256000, "output": 16000 } },
        "google/gemini-3.7-flash":     { "limit": { "context": 1000000, "output": 16000 } },
        "qwen/qwen3.8-27b":            { "limit": { "context": 262144, "output": 12000 } }
      }
    }
  }
}
