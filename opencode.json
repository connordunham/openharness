{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/HANDOFF.md", "docs/DOMAIN-DECISIONS.md"],
  "agent": {
    "harness-lead": {
      "model": "anthropic/claude-sonnet-4-5"
    },
    "implementer": {
      "model": "anthropic/claude-sonnet-4-5"
    },
    "reviewer": {
      "model": "openai/gpt-5"
    },
    "verifier": {
      "model": "anthropic/claude-sonnet-4-5"
    },
    "packet-scout": {
      "model": "ollama/qwen3-coder:30b"
    },
    "domain-auditor": {
      "model": "anthropic/claude-sonnet-4-5"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B A3B (local)"
        }
      }
    }
  }
}
